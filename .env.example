# LabLink Environment Configuration

# Core
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Security
SECRET_KEY=change_this_to_a_random_32_character_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for Render / Docker, SQLite fallback for local test)
DATABASE_URL=postgresql+psycopg://lablink_user:lablink_secure_password_2026@localhost:5432/lablink
# DATABASE_URL=sqlite:///./lablink.db

# Demo Admin Settings (Disable in Production)
DEMO_ADMIN_ENABLED=true
DEMO_ADMIN_EMAIL=admin@lablink.demo
DEMO_ADMIN_PASSWORD=LabLink@Demo2026

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# SMTP / Email Notifications (Optional)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@lablink.edu
SMTP_TLS=true
